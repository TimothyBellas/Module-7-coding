# Copy this file to .env. These documented defaults contain no secrets.
# Docker Compose values: service name and paths inside the backend container.
OLLAMA_URL=http://ollama:11434
MODEL_NAME=llama3.2:1b
CHROMA_PATH=/app/chroma_data
MAX_RESULTS=3
CONFIDENCE_THRESHOLD=1.0
DEBUG=false

DOCS_PATH=/app/docs
COLLECTION_NAME=documents
OLLAMA_TIMEOUT=180
OLLAMA_CONNECT_TIMEOUT=10
HEALTH_TIMEOUT=3
TEMPERATURE=0.1
INGEST_BATCH_SIZE=100
CORS_ORIGINS=["*"]
CHROMA_TELEMETRY=false

BACKEND_PORT=8000
OLLAMA_PORT=11434
OLLAMA_HOST=0.0.0.0:11434
